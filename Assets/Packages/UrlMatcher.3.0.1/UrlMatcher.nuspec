<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UrlMatcher</id>
    <version>3.0.1</version>
    <title>UrlMatcher</title>
    <authors>Joel Christner</authors>
    <license type="file">LICENSE.md</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/jchristn/UrlMatcher</projectUrl>
    <description>Simple URL matcher library allowing you to match based on explicit string or parameters</description>
    <releaseNotes>Refactor to support static and instance methods.</releaseNotes>
    <copyright>(c)2025 Joel Christner</copyright>
    <tags>url match matcher parameter</tags>
    <repository type="github" url="https://github.com/jchristn/UrlMatcher" commit="77aa9f6e24a344e1084126ed4e1f8ee9e6d86bf7" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2" />
      <group targetFramework=".NETFramework4.8" />
      <group targetFramework="net6.0" />
      <group targetFramework="net8.0" />
      <group targetFramework=".NETStandard2.0" />
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
    <contentFiles>
      <files include="any/net462/assets/icon.ico" buildAction="Content" />
      <files include="any/net48/assets/icon.ico" buildAction="Content" />
      <files include="any/net6.0/assets/icon.ico" buildAction="Content" />
      <files include="any/net8.0/assets/icon.ico" buildAction="Content" />
      <files include="any/netstandard2.0/assets/icon.ico" buildAction="Content" />
      <files include="any/netstandard2.1/assets/icon.ico" buildAction="Content" />
    </contentFiles>
  </metadata>
</package>