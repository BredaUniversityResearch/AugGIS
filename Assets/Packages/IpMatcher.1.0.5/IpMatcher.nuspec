<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>IpMatcher</id>
    <version>1.0.5</version>
    <title>IpMatcher</title>
    <authors>Joel Christner</authors>
    <license type="file">LICENSE.md</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/jchristn/ipmatcher</projectUrl>
    <description>Library for maintaining a match list of IP addresses and networks and comparing inputs to see if a match exists.</description>
    <releaseNotes>Retarget</releaseNotes>
    <copyright>(c)2025 Joel Christner</copyright>
    <tags>ip address match netmask network mask subnet cidr</tags>
    <repository type="Github" url="https://github.com/jchristn/ipmatcher" commit="6eac064bb1fbdcb6ad54d774e53c0a1afe17e4c8" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2" />
      <group targetFramework=".NETFramework4.8" />
      <group targetFramework="net6.0" />
      <group targetFramework="net8.0" />
      <group targetFramework=".NETStandard2.0" />
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
    <contentFiles>
      <files include="any/net462/icon.ico" buildAction="Content" />
      <files include="any/net48/icon.ico" buildAction="Content" />
      <files include="any/net6.0/icon.ico" buildAction="Content" />
      <files include="any/net8.0/icon.ico" buildAction="Content" />
      <files include="any/netstandard2.0/icon.ico" buildAction="Content" />
      <files include="any/netstandard2.1/icon.ico" buildAction="Content" />
    </contentFiles>
  </metadata>
</package>